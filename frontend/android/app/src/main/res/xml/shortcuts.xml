<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. Built-in Intent: Open App Feature (Gold, Gym, Reminders, Jobs, Notes, Shifts, Voice Assistant) -->
    <capability android:name="actions.intent.OPEN_APP_FEATURE">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.remindbuddy.remindbuddy"
            android:targetClass="com.remindbuddy.remindbuddy.MainActivity">
            <url-template android:value="smartbuddy://assistant?feature={feature}" />
            <parameter
                android:name="feature"
                android:key="feature" />
        </intent>
    </capability>

    <!-- 2. Built-in Intent: Start Exercise / Workout ("Hey Google, start workout on SmartBuddy") -->
    <capability android:name="actions.intent.START_EXERCISE">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.remindbuddy.remindbuddy"
            android:targetClass="com.remindbuddy.remindbuddy.MainActivity">
            <url-template android:value="smartbuddy://assistant?feature=gym&amp;action=start_workout&amp;exercise={exercise}" />
            <parameter
                android:name="exercise.name"
                android:key="exercise" />
        </intent>
    </capability>

    <!-- 3. Built-in Intent: Create Reminder ("Hey Google, create a reminder on SmartBuddy") -->
    <capability android:name="actions.intent.CREATE_REMINDER">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.remindbuddy.remindbuddy"
            android:targetClass="com.remindbuddy.remindbuddy.MainActivity">
            <url-template android:value="smartbuddy://assistant?feature=reminders&amp;action=create&amp;query={text}" />
            <parameter
                android:name="reminder.text"
                android:key="text" />
        </intent>
    </capability>

    <!-- 4. Built-in Intent: Get Thing / Check Rate ("Hey Google, check gold on SmartBuddy") -->
    <capability android:name="actions.intent.GET_THING">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.remindbuddy.remindbuddy"
            android:targetClass="com.remindbuddy.remindbuddy.MainActivity">
            <url-template android:value="smartbuddy://assistant?feature={thing}&amp;query={thing}" />
            <parameter
                android:name="thing.name"
                android:key="thing" />
        </intent>
    </capability>

    <!-- Static Shortcuts for Launcher Long-Press & Google Assistant -->
    <shortcut
        android:shortcutId="shortcut_gold_rates"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_gold_short"
        android:shortcutLongLabel="@string/shortcut_gold_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.remindbuddy.remindbuddy"
            android:targetClass="com.remindbuddy.remindbuddy.MainActivity"
            android:data="smartbuddy://assistant?feature=gold" />
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding
                android:key="feature"
                android:value="gold" />
        </capability-binding>
        <capability-binding android:key="actions.intent.GET_THING">
            <parameter-binding
                android:key="thing.name"
                android:value="gold" />
        </capability-binding>
    </shortcut>

    <shortcut
        android:shortcutId="shortcut_gym_workout"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_gym_short"
        android:shortcutLongLabel="@string/shortcut_gym_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.remindbuddy.remindbuddy"
            android:targetClass="com.remindbuddy.remindbuddy.MainActivity"
            android:data="smartbuddy://assistant?feature=gym&amp;action=start_workout" />
        <capability-binding android:key="actions.intent.START_EXERCISE">
            <parameter-binding
                android:key="exercise.name"
                android:value="@string/feature_gym_name" />
        </capability-binding>
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding
                android:key="feature"
                android:value="gym" />
        </capability-binding>
    </shortcut>

    <shortcut
        android:shortcutId="shortcut_create_reminder"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_reminder_short"
        android:shortcutLongLabel="@string/shortcut_reminder_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.remindbuddy.remindbuddy"
            android:targetClass="com.remindbuddy.remindbuddy.MainActivity"
            android:data="smartbuddy://assistant?feature=reminders&amp;action=create" />
        <capability-binding android:key="actions.intent.CREATE_REMINDER" />
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding
                android:key="feature"
                android:value="reminders" />
        </capability-binding>
    </shortcut>

    <shortcut
        android:shortcutId="shortcut_voice_assistant"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_voice_short"
        android:shortcutLongLabel="@string/shortcut_voice_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.remindbuddy.remindbuddy"
            android:targetClass="com.remindbuddy.remindbuddy.MainActivity"
            android:data="smartbuddy://assistant?feature=voice_assistant" />
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding
                android:key="feature"
                android:value="voice_assistant" />
        </capability-binding>
    </shortcut>

    <shortcut
        android:shortcutId="shortcut_job_assistant"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/feature_jobs_name"
        android:shortcutLongLabel="@string/feature_jobs_name">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.remindbuddy.remindbuddy"
            android:targetClass="com.remindbuddy.remindbuddy.MainActivity"
            android:data="smartbuddy://assistant?feature=job_assistant" />
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding
                android:key="feature"
                android:value="job_assistant" />
        </capability-binding>
    </shortcut>

    <shortcut
        android:shortcutId="shortcut_notes"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/feature_notes_name"
        android:shortcutLongLabel="@string/feature_notes_name">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.remindbuddy.remindbuddy"
            android:targetClass="com.remindbuddy.remindbuddy.MainActivity"
            android:data="smartbuddy://assistant?feature=notes" />
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding
                android:key="feature"
                android:value="notes" />
        </capability-binding>
    </shortcut>

</shortcuts>
