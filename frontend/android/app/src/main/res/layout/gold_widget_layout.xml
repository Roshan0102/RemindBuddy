<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_gold_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_gold_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🥇 Live 22K Gold"
            android:textColor="#FDE047"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_gold_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Updated Today"
            android:textColor="#94A3B8"
            android:textSize="10sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#1E293B" />

    <!-- 22K Prices: Row 1 (Per Gram) & Row 2 (Per Sovereign / 8 Grams) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Row 1: 22K 1 Gram -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="22K (Per 1 Gram)"
                android:textColor="#E2E8F0"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/widget_gold_22k_gram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0/g"
                android:textColor="#FDE047"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 2: 22K 1 Sovereign (8 Grams) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="22K (Per 8 Grams)"
                android:textColor="#E2E8F0"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/widget_gold_22k_sovereign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0 (8g)"
                android:textColor="#FDE047"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#1E293B" />

    <!-- Footer Row: Trend & Tap action -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_gold_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_green"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="Live Rate"
            android:textColor="#22C55E"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="Tap to view insights →"
            android:textColor="#64748B"
            android:textSize="9.5sp" />
    </LinearLayout>
</LinearLayout>
